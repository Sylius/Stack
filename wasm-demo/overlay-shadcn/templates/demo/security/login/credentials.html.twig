<twig:shadcn:Alert class="border-info/30 bg-info/5 *:[svg]:text-info">
    {{ ux_icon('lucide:info', {'aria-hidden': 'true'}) }}
    <twig:shadcn:Alert:Title>{{ 'app.demo.test_credentials'|trans({}, 'demo') }}</twig:shadcn:Alert:Title>
    <twig:shadcn:Alert:Description>
        <p>
            {{ 'app.demo.username'|trans({}, 'demo') }}: <strong>admin@example.com</strong><br>
            {{ 'app.demo.password'|trans({}, 'demo') }}: <strong>admin</strong>
        </p>
    </twig:shadcn:Alert:Description>
</twig:shadcn:Alert>
