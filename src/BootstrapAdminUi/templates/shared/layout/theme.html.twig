<script>
    (function() {
        const root = document.documentElement;
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const getMode = () => {
            const stored = localStorage.getItem('sylius-theme');

            return stored === 'light' || stored === 'dark' ? stored : 'auto';
        };
        const apply = () => {
            const mode = getMode();
            root.setAttribute('data-theme-mode', mode);
            root.setAttribute('data-bs-theme', mode === 'auto' ? (media.matches ? 'dark' : 'light') : mode);
        };

        apply();
        media.addEventListener('change', apply);
        window.addEventListener('storage', (event) => (event.key === 'sylius-theme' || event.key === null) && apply());
    })();
</script>
