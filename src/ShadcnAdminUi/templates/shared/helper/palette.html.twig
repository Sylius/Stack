{#
    Palette of tones: turns a color name (the historical Tabler palette, as returned by application
    enums) into Tailwind classes. Classes are written in full: Tailwind does not detect a class built
    by concatenation (never "bg-" ~ color in a template). Shades come from the --tone-* tokens of
    assets/styles/theme.css.

    tone(color, kind) - kind: soft (tinted background + text), solid (filled background), text, dot,
                              hover (filled background on hover/focus of a "group/tile" parent),
                              alert (border + tinted background of a shadcn:Alert).
    Unknown or empty color: neutral rendering (secondary).
#}
{% macro tone(color, kind = 'soft') -%}
    {%- set palette = {
        blue: {soft: 'bg-tone-blue/10 text-tone-blue dark:bg-tone-blue/15', solid: 'bg-tone-blue text-background', text: 'text-tone-blue', dot: 'bg-tone-blue', hover: 'group-hover/tile:bg-tone-blue group-hover/tile:text-background group-focus-visible/tile:bg-tone-blue group-focus-visible/tile:text-background', alert: 'border-tone-blue/30 bg-tone-blue/10 text-tone-blue dark:bg-tone-blue/15'},
        azure: {soft: 'bg-tone-azure/10 text-tone-azure dark:bg-tone-azure/15', solid: 'bg-tone-azure text-background', text: 'text-tone-azure', dot: 'bg-tone-azure', hover: 'group-hover/tile:bg-tone-azure group-hover/tile:text-background group-focus-visible/tile:bg-tone-azure group-focus-visible/tile:text-background', alert: 'border-tone-azure/30 bg-tone-azure/10 text-tone-azure dark:bg-tone-azure/15'},
        indigo: {soft: 'bg-tone-indigo/10 text-tone-indigo dark:bg-tone-indigo/15', solid: 'bg-tone-indigo text-background', text: 'text-tone-indigo', dot: 'bg-tone-indigo', hover: 'group-hover/tile:bg-tone-indigo group-hover/tile:text-background group-focus-visible/tile:bg-tone-indigo group-focus-visible/tile:text-background', alert: 'border-tone-indigo/30 bg-tone-indigo/10 text-tone-indigo dark:bg-tone-indigo/15'},
        purple: {soft: 'bg-tone-purple/10 text-tone-purple dark:bg-tone-purple/15', solid: 'bg-tone-purple text-background', text: 'text-tone-purple', dot: 'bg-tone-purple', hover: 'group-hover/tile:bg-tone-purple group-hover/tile:text-background group-focus-visible/tile:bg-tone-purple group-focus-visible/tile:text-background', alert: 'border-tone-purple/30 bg-tone-purple/10 text-tone-purple dark:bg-tone-purple/15'},
        pink: {soft: 'bg-tone-pink/10 text-tone-pink dark:bg-tone-pink/15', solid: 'bg-tone-pink text-background', text: 'text-tone-pink', dot: 'bg-tone-pink', hover: 'group-hover/tile:bg-tone-pink group-hover/tile:text-background group-focus-visible/tile:bg-tone-pink group-focus-visible/tile:text-background', alert: 'border-tone-pink/30 bg-tone-pink/10 text-tone-pink dark:bg-tone-pink/15'},
        red: {soft: 'bg-tone-red/10 text-tone-red dark:bg-tone-red/15', solid: 'bg-tone-red text-background', text: 'text-tone-red', dot: 'bg-tone-red', hover: 'group-hover/tile:bg-tone-red group-hover/tile:text-background group-focus-visible/tile:bg-tone-red group-focus-visible/tile:text-background', alert: 'border-tone-red/30 bg-tone-red/10 text-tone-red dark:bg-tone-red/15'},
        orange: {soft: 'bg-tone-orange/10 text-tone-orange dark:bg-tone-orange/15', solid: 'bg-tone-orange text-background', text: 'text-tone-orange', dot: 'bg-tone-orange', hover: 'group-hover/tile:bg-tone-orange group-hover/tile:text-background group-focus-visible/tile:bg-tone-orange group-focus-visible/tile:text-background', alert: 'border-tone-orange/30 bg-tone-orange/10 text-tone-orange dark:bg-tone-orange/15'},
        yellow: {soft: 'bg-tone-yellow/10 text-tone-yellow dark:bg-tone-yellow/15', solid: 'bg-tone-yellow text-background', text: 'text-tone-yellow', dot: 'bg-tone-yellow', hover: 'group-hover/tile:bg-tone-yellow group-hover/tile:text-background group-focus-visible/tile:bg-tone-yellow group-focus-visible/tile:text-background', alert: 'border-tone-yellow/30 bg-tone-yellow/10 text-tone-yellow dark:bg-tone-yellow/15'},
        lime: {soft: 'bg-tone-lime/10 text-tone-lime dark:bg-tone-lime/15', solid: 'bg-tone-lime text-background', text: 'text-tone-lime', dot: 'bg-tone-lime', hover: 'group-hover/tile:bg-tone-lime group-hover/tile:text-background group-focus-visible/tile:bg-tone-lime group-focus-visible/tile:text-background', alert: 'border-tone-lime/30 bg-tone-lime/10 text-tone-lime dark:bg-tone-lime/15'},
        green: {soft: 'bg-tone-green/10 text-tone-green dark:bg-tone-green/15', solid: 'bg-tone-green text-background', text: 'text-tone-green', dot: 'bg-tone-green', hover: 'group-hover/tile:bg-tone-green group-hover/tile:text-background group-focus-visible/tile:bg-tone-green group-focus-visible/tile:text-background', alert: 'border-tone-green/30 bg-tone-green/10 text-tone-green dark:bg-tone-green/15'},
        teal: {soft: 'bg-tone-teal/10 text-tone-teal dark:bg-tone-teal/15', solid: 'bg-tone-teal text-background', text: 'text-tone-teal', dot: 'bg-tone-teal', hover: 'group-hover/tile:bg-tone-teal group-hover/tile:text-background group-focus-visible/tile:bg-tone-teal group-focus-visible/tile:text-background', alert: 'border-tone-teal/30 bg-tone-teal/10 text-tone-teal dark:bg-tone-teal/15'},
        cyan: {soft: 'bg-tone-cyan/10 text-tone-cyan dark:bg-tone-cyan/15', solid: 'bg-tone-cyan text-background', text: 'text-tone-cyan', dot: 'bg-tone-cyan', hover: 'group-hover/tile:bg-tone-cyan group-hover/tile:text-background group-focus-visible/tile:bg-tone-cyan group-focus-visible/tile:text-background', alert: 'border-tone-cyan/30 bg-tone-cyan/10 text-tone-cyan dark:bg-tone-cyan/15'},
        success: {soft: 'bg-tone-green/10 text-tone-green dark:bg-tone-green/15', solid: 'bg-tone-green text-background', text: 'text-tone-green', dot: 'bg-tone-green', hover: 'group-hover/tile:bg-tone-green group-hover/tile:text-background group-focus-visible/tile:bg-tone-green group-focus-visible/tile:text-background', alert: 'border-tone-green/30 bg-tone-green/10 text-tone-green dark:bg-tone-green/15'},
        danger: {soft: 'bg-tone-red/10 text-tone-red dark:bg-tone-red/15', solid: 'bg-tone-red text-background', text: 'text-tone-red', dot: 'bg-tone-red', hover: 'group-hover/tile:bg-tone-red group-hover/tile:text-background group-focus-visible/tile:bg-tone-red group-focus-visible/tile:text-background', alert: 'border-tone-red/30 bg-tone-red/10 text-tone-red dark:bg-tone-red/15'},
        warning: {soft: 'bg-tone-yellow/10 text-tone-yellow dark:bg-tone-yellow/15', solid: 'bg-tone-yellow text-background', text: 'text-tone-yellow', dot: 'bg-tone-yellow', hover: 'group-hover/tile:bg-tone-yellow group-hover/tile:text-background group-focus-visible/tile:bg-tone-yellow group-focus-visible/tile:text-background', alert: 'border-tone-yellow/30 bg-tone-yellow/10 text-tone-yellow dark:bg-tone-yellow/15'},
        brown: {soft: 'bg-tone-orange/10 text-tone-orange dark:bg-tone-orange/15', solid: 'bg-tone-orange text-background', text: 'text-tone-orange', dot: 'bg-tone-orange', hover: 'group-hover/tile:bg-tone-orange group-hover/tile:text-background group-focus-visible/tile:bg-tone-orange group-focus-visible/tile:text-background', alert: 'border-tone-orange/30 bg-tone-orange/10 text-tone-orange dark:bg-tone-orange/15'},
        info: {soft: 'bg-tone-azure/10 text-tone-azure dark:bg-tone-azure/15', solid: 'bg-tone-azure text-background', text: 'text-tone-azure', dot: 'bg-tone-azure', hover: 'group-hover/tile:bg-tone-azure group-hover/tile:text-background group-focus-visible/tile:bg-tone-azure group-focus-visible/tile:text-background', alert: 'border-tone-azure/30 bg-tone-azure/10 text-tone-azure dark:bg-tone-azure/15'},
        secondary: {soft: 'bg-muted text-muted-foreground', solid: 'bg-muted-foreground text-background', text: 'text-muted-foreground', dot: 'bg-muted-foreground', hover: 'group-hover/tile:bg-muted-foreground group-hover/tile:text-background group-focus-visible/tile:bg-muted-foreground group-focus-visible/tile:text-background', alert: 'bg-muted text-foreground'},
        dark: {soft: 'bg-foreground/10 text-foreground', solid: 'bg-foreground text-background', text: 'text-foreground', dot: 'bg-foreground', hover: 'group-hover/tile:bg-foreground group-hover/tile:text-background group-focus-visible/tile:bg-foreground group-focus-visible/tile:text-background', alert: 'border-foreground/30 bg-foreground/5 text-foreground'},
        primary: {soft: 'bg-primary/10 text-primary', solid: 'bg-primary text-primary-foreground', text: 'text-primary', dot: 'bg-primary', hover: 'group-hover/tile:bg-primary group-hover/tile:text-primary-foreground group-focus-visible/tile:bg-primary group-focus-visible/tile:text-primary-foreground', alert: 'border-primary/30 bg-primary/5 text-primary'},
    } -%}
    {%- set aliases = {muted: 'secondary', gray: 'secondary', grey: 'secondary', body: 'dark', black: 'dark'} -%}
    {%- set color = aliases[color] ?? color -%}
    {{- (palette[color] ?? palette.secondary)[kind] -}}
{%- endmacro %}
